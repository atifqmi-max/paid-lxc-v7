# Copy this file to ".env" and fill in your own values.
# Never commit or share your real .env file — it contains your bot token.

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Branding
BOT_NAME=StoneNodes
PREFIX=+
BOT_LOGO_URL=https://i.imgur.com/2yYjGwT.png

# Your Discord user ID (right-click your name in Discord -> Copy User ID,
# Developer Mode must be enabled in Discord Settings -> Advanced)
MAIN_ADMIN_ID=

# The role ID the bot should assign to VPS owners. You can leave this as 0
# and the bot will create a "VPS User" role automatically on first use.
VPS_USER_ROLE_ID=0

# The public IP of the machine running LXC/LXD (used for SSH/port info)
YOUR_SERVER_IP=127.0.0.1

# LXD/LXC storage pool name (run "lxc storage list" to see yours)
DEFAULT_STORAGE_POOL=default

BOT_VERSION=1.0
BOT_DEVELOPER=StoneNodes Team
