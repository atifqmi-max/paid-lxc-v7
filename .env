# =========================================
# PAID_LXC_v7 Discord Bot - Environment Config
# =========================================
# Copy this file as ".env" in the same folder as PAID_LXC_v7_bot.py
# NEVER commit this file to GitHub / share it publicly.

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Display name for the bot (used in logs, embeds, help menu)
BOT_NAME=Night Cloud Free - Nodes 1

# Command prefix (e.g. "." means commands look like .create, .myvps, etc.)
PREFIX=.

# Your server / node public or local IP (shown to users for connection info)
YOUR_SERVER_IP=127.0.0.1

# Discord user ID of the main/super admin (full control, can add/remove admins)
MAIN_ADMIN_ID=123456789012345678

# Discord role ID given to users who are allowed to own a VPS
VPS_USER_ROLE_ID=123456789012345678

# LXD/LXC storage pool to create containers in (check with: lxc storage list)
DEFAULT_STORAGE_POOL=default

# Cosmetic version/developer tags shown in bot info
BOT_VERSION=1.0
BOT_DEVELOPER=Admin
